[Unit]
Description=Publish completed stock research to AH Note
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/aicode/ah-note.github.io
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 scripts/watch_stock_report.py --stock-report-root %h/aicode/stock_report --state-file %h/aicode/runs/ah-note-publisher/state.json --interval-seconds 20 --settle-seconds 10
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
